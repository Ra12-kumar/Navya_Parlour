# All values are public (NEXT_PUBLIC_*). Never put secrets here.
# Live domain, used for canonical URLs, Open Graph, sitemap and robots.
NEXT_PUBLIC_SITE_URL=https://example.com
# Optional: exact salon pin. Google Maps -> Share -> Embed a map -> copy the src="..." value.
NEXT_PUBLIC_MAP_EMBED_URL=
# Optional: Google Maps share / directions link for the salon.
NEXT_PUBLIC_MAP_DIRECTIONS_URL=
